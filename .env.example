# --- Database ---
POSTGRES_USER=telcoscope
POSTGRES_PASSWORD=telcoscope
POSTGRES_DB=telcoscope
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000

# --- Adminer ---
ADMINER_PORT=8080

# --- Anthropic API (for LLM RCA narrator) ---
# Get a key from https://console.anthropic.com/
# Leave blank to disable the narrator and use mock mode instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
NARRATOR_MODE=mock   # 'mock' for offline / CI, 'live' to call the API

# --- Synthetic data generator ---
SYNTH_NUM_CELLS=100
SYNTH_DAYS=30
SYNTH_SEED=42

# --- App ---
LOG_LEVEL=INFO
APP_ENV=local
