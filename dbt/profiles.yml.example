# Copy this file to ~/.dbt/profiles.yml and adjust as needed.
# Or, for project-local profiles, place in dbt/profiles.yml and run dbt with
# `dbt --profiles-dir dbt ...`.

telcoscope:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST', 'localhost') }}"
      port: "{{ env_var('POSTGRES_PORT', '5432') | as_number }}"
      user: "{{ env_var('POSTGRES_USER', 'telcoscope') }}"
      password: "{{ env_var('POSTGRES_PASSWORD', 'telcoscope') }}"
      dbname: "{{ env_var('POSTGRES_DB', 'telcoscope') }}"
      schema: dbt_dev
      threads: 4
      keepalives_idle: 0
      connect_timeout: 10

    ci:
      type: postgres
      host: localhost
      port: 5432
      user: telcoscope
      password: telcoscope
      dbname: telcoscope_test
      schema: dbt_ci
      threads: 4
