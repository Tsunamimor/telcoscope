          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH recent AS (\r\n    SELECT ts_start, ts_end, cell_id, severity, methods, detection_count, dominant_kpi\r\n    FROM dbt_dev_marts.mart_incidents_timeline\r\n    ORDER BY ts_start DESC\r\n    LIMIT 50\r\n),\r\nrepeat_counts AS (\r\n    SELECT cell_id, COUNT(*) AS occurrences_in_top50\r\n    FROM recent\r\n    GROUP BY cell_id\r\n)\r\nSELECT r.ts_start,\r\n       r.ts_end,\r\n       r.cell_id,\r\n       rc.occurrences_in_top50,\r\n       r.severity,\r\n       r.methods,\r\n       r.detection_count,\r\n       r.dominant_kpi\r\nFROM recent r\r\nJOIN repeat_counts rc USING (cell_id)\r\nORDER BY r.ts_start DESC;\r\n",
