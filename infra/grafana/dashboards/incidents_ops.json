          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH top_cells AS (\r\n    SELECT cell_id\r\n    FROM dbt_dev_marts.mart_incidents_timeline\r\n    WHERE $__timeFilter(ts_start)\r\n      AND severity IN ($severity)\r\n    GROUP BY cell_id\r\n    ORDER BY SUM(detection_count) DESC\r\n    LIMIT ${top_n:raw}\r\n)\r\nSELECT m.cell_id::text  AS cell,\r\n       m.severity,\r\n       SUM(m.detection_count) AS total_detections\r\nFROM dbt_dev_marts.mart_incidents_timeline m\r\nJOIN top_cells t USING (cell_id)\r\nWHERE $__timeFilter(m.ts_start)\r\n  AND m.severity IN ($severity)\r\nGROUP BY m.cell_id, m.severity, m.detection_count\r\nORDER BY m.detection_count DESC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Top ${top_n} cells by incident count (${severity:pipe})",
      "type": "barchart"
